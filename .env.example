# =============================================================================
# ExamPortal Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# =============================================================================

# Application Runtime
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5000

# PostgreSQL Connection (Local or Render)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exam_portal_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=exam_portal_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=20

# JWT Security & Auth
JWT_SECRET=super_secret_development_jwt_key_replace_in_production_min_32_characters
JWT_EXPIRES_IN=24h

# Security Rate Limiter
RATE_LIMIT_MAX=300
